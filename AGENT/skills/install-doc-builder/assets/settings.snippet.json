{
  "permissions": {
    "deny": [
      "Write(**/00-index.md)",
      "Edit(**/00-index.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/run-doc-index.sh --hook"
          }
        ]
      }
    ]
  }
}
